#!/bin/sh
set -e

. /usr/share/debconf/confmodule

legacy_config=""
if [ -f /etc/amp-panel/amp-panel.env ]; then
    legacy_config=/etc/amp-panel/amp-panel.env
elif [ -f /etc/amp-dashboard/dashboard.env ]; then
    legacy_config=/etc/amp-dashboard/dashboard.env
elif [ -f /home/debian/Dashboard_Project/.env ]; then
    legacy_config=/home/debian/Dashboard_Project/.env
elif command -v systemctl >/dev/null 2>&1; then
    legacy_working_directory="$(
        systemctl show amp-dashboard.service \
            --property=WorkingDirectory --value 2>/dev/null || true
    )"
    if [ -n "${legacy_working_directory}" ] &&
       [ -f "${legacy_working_directory}/.env" ]; then
        legacy_config="${legacy_working_directory}/.env"
    fi
fi

if [ -n "${legacy_config}" ]; then
    exit 0
fi

db_get amp-panel/serial-port || RET=""
if [ -z "${RET}" ]; then
    if [ -e /dev/ttyACM0 ]; then
        db_set amp-panel/serial-port /dev/ttyACM0
    elif [ -e /dev/ttyUSB0 ]; then
        db_set amp-panel/serial-port /dev/ttyUSB0
    else
        db_set amp-panel/serial-port /dev/ttyACM0
    fi
fi

db_get amp-panel/mdns-hostname || RET=""
if [ -z "${RET}" ]; then
    mdns_hostname="$(
        hostname |
            tr '[:upper:]_' '[:lower:]-' |
            sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-*//; s/-*$//' |
            cut -c1-63
    )"
    db_set amp-panel/mdns-hostname "${mdns_hostname:-amp-panel}"
fi

db_input high amp-panel/admin-username || true
db_input high amp-panel/port || true
db_input high amp-panel/data-dir || true
db_input high amp-panel/serial-port || true
db_input high amp-panel/gain-min || true
db_input high amp-panel/gain-max || true
db_input high amp-panel/port-count || true
db_input high amp-panel/radius-server || true
db_input high amp-panel/radius-port || true
db_input high amp-panel/radius-secret || true
db_input high amp-panel/mdns-hostname || true
db_go
