#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if [ -f /etc/amp-panel/amp-panel.env ]; then
    exit 0
fi

db_get amp-panel/mdns-hostname || RET=""
if [ -z "${RET}" ]; then
    mdns_hostname="$(
        hostname |
            tr '[:upper:]_' '[:lower:]-' |
            sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-*//; s/-*$//' |
            cut -c1-63
    )"
    db_set amp-panel/mdns-hostname "${mdns_hostname:-amp-panel}"
fi

db_input high amp-panel/enabled-devices || true
db_go
db_get amp-panel/enabled-devices || RET="local, remote, oba, oba3"
enabled_devices="${RET}"

db_input high amp-panel/admin-username || true
db_input high amp-panel/auth-mode || true
db_input high amp-panel/port || true
db_input high amp-panel/data-dir || true
db_input high amp-panel/xml-status-file || true
db_get amp-panel/auth-mode || RET="radius"
case "${RET}" in
    local|"Local passwords on this device")
        db_input high amp-panel/local-admin-password || true
        ;;
    *)
        db_input high amp-panel/radius-server || true
        db_input high amp-panel/radius-port || true
        db_input high amp-panel/radius-secret || true
        ;;
esac
db_input high amp-panel/mdns-hostname || true
db_go
